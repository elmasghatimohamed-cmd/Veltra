    {
      "name": "Trajets",
      "item": [
        {
          "name": "Créer un trajet",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Les dates sont calculées dans le fuseau horaire de Casablanca, puis réutilisées par les autres requêtes.\nconst timeZone = \"Africa/Casablanca\";\nfunction formatMoroccoDate(date) {\n    const parts = new Intl.DateTimeFormat(\"en-GB\", {\n        timeZone,\n        year: \"numeric\", month: \"2-digit\", day: \"2-digit\",\n        hour: \"2-digit\", minute: \"2-digit\", second: \"2-digit\", hourCycle: \"h23\"\n    }).formatToParts(date);\n    const get = type => parts.find(p => p.type === type).value;\n    return `${get(\"year\")}-${get(\"month\")}-${get(\"day\")}T${get(\"hour\")}:${get(\"minute\")}:${get(\"second\")}`;\n}\nconst now = Date.now();\nconst day = 24 * 60 * 60 * 1000;\npm.collectionVariables.set(\"depart\", formatMoroccoDate(new Date(now + 3 * day)));\npm.collectionVariables.set(\"arrivee\", formatMoroccoDate(new Date(now + 3 * day + 60 * 60 * 1000)));\npm.collectionVariables.set(\"dateRecherche\", formatMoroccoDate(new Date(now + 2 * day)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {\n    pm.response.to.have.status(201);\n});\n\nif (pm.response.code === 201) {\n    const data = pm.response.json();\n    pm.test(\"Trajet : ID retourné\", function () {\n        pm.expect(data.id).to.not.be.undefined;\n        pm.expect(data.id).to.not.be.null;\n    });\n    if (data.id != null) pm.collectionVariables.set(\"trajetId\", String(data.id));\n}\n\nfunction enregistrerArrets(data) {\n    if (!Array.isArray(data.pointsArret)) return;\n    const depart = data.pointsArret.find(p => p.ville === \"Nador\");\n    const arrivee = data.pointsArret.find(p => p.ville === \"Fes\");\n    if (depart && depart.id != null) pm.collectionVariables.set(\"pointMonteeId\", String(depart.id));\n    if (arrivee && arrivee.id != null) pm.collectionVariables.set(\"pointDescenteId\", String(arrivee.id));\n}\n\nif (pm.response.code === 201) enregistrerArrets(pm.response.json());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conducteurId\": {{conducteurId}},\n  \"vehiculeId\": {{vehiculeId}},\n  \"dateDepart\": \"{{depart}}\",\n  \"placesProposees\": 3,\n  \"pointsArret\": [\n    {\n      \"ville\": \"Nador\",\n      \"ordre\": 0,\n      \"heurePassage\": \"{{depart}}\",\n      \"prixDepuisDepart\": 0\n    },\n    {\n      \"ville\": \"Fes\",\n      \"ordre\": 1,\n      \"heurePassage\": \"{{arrivee}}\",\n      \"prixDepuisDepart\": 100\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/trajets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trajets"
              ]
            },
            "description": "Crée un trajet à J+3, avec deux arrêts, et mémorise les IDs de ses arrêts."
          },
          "response": []
        },
        {
          "name": "Consulter le trajet et récupérer les arrêts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "function enregistrerArrets(data) {",
                  "    if (!Array.isArray(data.pointsArret)) return;",
                  "    const depart = data.pointsArret.find(p => p.ville === \"Nador\");",
                  "    const arrivee = data.pointsArret.find(p => p.ville === \"Fes\");",
                  "    if (depart && depart.id != null) pm.collectionVariables.set(\"pointMonteeId\", String(depart.id));",
                  "    if (arrivee && arrivee.id != null) pm.collectionVariables.set(\"pointDescenteId\", String(arrivee.id));",
                  "}",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
