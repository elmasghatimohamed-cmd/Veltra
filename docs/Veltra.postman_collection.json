      "name": "Conducteur",
      "item": [
        {
          "name": "Créer un conducteur",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Un nouvel identifiant de démonstration évite les conflits d'unicité à chaque exécution.",
                  "pm.collectionVariables.set(\"runSuffix\", Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Conducteur : ID retourné\", function () {",
                  "        pm.expect(data.id).to.not.be.undefined;",
                  "        pm.expect(data.id).to.not.be.null;",
                  "    });",
                  "    if (data.id != null) pm.collectionVariables.set(\"conducteurId\", String(data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"El Masghati\",\n  \"prenom\": \"Mohamed\",\n  \"email\": \"mohamed+{{runSuffix}}@example.com\",\n  \"telephone\": \"0611111111\",\n  \"numeroPermis\": \"PERMIS{{runSuffix}}\"\n}",
